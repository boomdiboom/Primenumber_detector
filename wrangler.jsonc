{
  // Cloudflare Workers 정적 에셋 배포.
  // 대시보드의 Git 연동(Workers Builds)이 push마다 `wrangler deploy`를 실행하며,
  // name은 연결된 Workers 서비스명과 일치해야 한다.
  "name": "primenumberdetector",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./public"
  },
  // 커스텀 도메인 — 존(jeongjuhaeng.net)이 같은 계정에 있으므로 deploy 시 DNS·인증서 자동 부착
  "routes": [
    { "pattern": "prime.jeongjuhaeng.net", "custom_domain": true }
  ]
}
